# Copy to /opt/cdl-demo/.env.demo on the server, fill in, chmod 600. Never commit the real file.
# Generate values on the server, never paste them into chat:
#   POSTGRES_PASSWORD  openssl rand -base64 24 | tr -d '/+='
#   SESSION_SECRET     openssl rand -hex 32          (64 characters; the app refuses anything under 32)
# The demo must use its OWN SESSION_SECRET: a different value from the real instance's.
POSTGRES_USER=cdldemo
POSTGRES_DB=cdldemo
POSTGRES_PASSWORD=
SESSION_SECRET=
