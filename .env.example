# Frontline CDL Staffing — voice AI intake system
# Copy to .env and fill in. NEVER commit .env.
#
# Legend:
#   [have]    already present in your .env
#   [MISSING] not present — needed for the work described in docs/AUDIT.md
#   [n8n]     ALSO/INSTEAD belongs in the n8n credential store, not just here.
#             n8n HTTP Request nodes cannot read this file — see docs/ZOHO-SETUP.md.

# ---------------------------------------------------------------------------
# VAPI
# ---------------------------------------------------------------------------
VAPI_PRIVATE_KEY=                       # [have]    server-side API key
VAPI_PUBLIC_KEY=                        # [MISSING] only needed for web/SDK calls

# Your current .env defines VAPI_ASSISTANT_ID TWICE. There are two distinct
# assistants, so give them distinct names — a duplicate key is silently
# overwritten by the last one.
VAPI_NEW_LEAD_ASSISTANT_ID=6901a714-a6c5-45a2-9395-455e09e0051b
VAPI_EXISTING_LEAD_ASSISTANT_ID=542bae1c-51b5-4d83-a3fe-446836b4801d
VAPI_LOG_APPLICANT_TOOL_ID=41a0ca37-e396-4aac-bd6c-472a33a45ef1

# [MISSING] No phone number is currently attached to either CDL assistant.
# The inbound flow is unreachable until a number is provisioned and its
# server.url is pointed at the assistant-request webhook. See AUDIT #1.
VAPI_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# WARNING: these are two DIFFERENT n8n instances. The API key below points at
# the self-hosted copy where all 119 workflows are INACTIVE. The workflows VAPI
# actually calls live on the n8n Cloud host. See AUDIT #2.
N8N_BASE_URL=https://n8n.accelentai.com/   # [have] management API target
N8N_API_KEY=                               # [have]

# [MISSING] Host that actually serves the production webhooks VAPI calls.
N8N_WEBHOOK_BASE_URL=https://accelentai.app.n8n.cloud

# ---------------------------------------------------------------------------
# Zoho Recruit  — THIS IS WHAT YOU ASKED ABOUT
# ---------------------------------------------------------------------------
# Created in the Zoho API Console (https://api-console.zoho.com) as a
# "Server-based Applications" so n8n can complete the OAuth authorization-code
# flow and refresh access automatically. Full walkthrough in docs/ZOHO-SETUP.md.
ZOHO_CLIENT_ID=                         # [have]    ROTATE — was hardcoded in n8n, now exposed
ZOHO_CLIENT_SECRET=                     # [have]    ROTATE — was hardcoded in n8n, now exposed
ZOHO_REFRESH_TOKEN=                     # [have]    ROTATE — was hardcoded in n8n, now exposed

# Datacenter domains. CONFIRMED US (.com) — the org is at
# https://recruit.zoho.com/recruit, so the domains hardcoded in the existing
# workflows are correct. Not present in .env yet; add them rather than relying
# on hardcoded URLs inside n8n nodes.
# (Other DCs, for reference: .eu / .in / .com.au — a mismatch returns a bare
#  "invalid_client" with no useful detail.)
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_RECRUIT_API_DOMAIN=https://recruit.zoho.com

# [MISSING] Scopes the refresh token must have been granted. Recorded here for
# reference — scopes are baked into the token at generation time, not sent per
# request. If you add a module later you must regenerate the refresh token.
#   ZohoRecruit.modules.ALL       create/update Candidates, Notes, Interviews
#   ZohoRecruit.settings.ALL      read module + field metadata (schema checks)
ZOHO_SCOPES=ZohoRecruit.modules.ALL,ZohoRecruit.settings.ALL

# ---------------------------------------------------------------------------
# Airtable  — currently the real system of record. See AUDIT #3.
# ---------------------------------------------------------------------------
AIRTABLE_API_KEY=                       # [MISSING] personal access token (pat...)
AIRTABLE_BASE_ID=appFUcIpdu3EwEIHn      # "Truck Driver Leads"
AIRTABLE_LEADS_TABLE_ID=tblNhoJ4P7lVNp84d
AIRTABLE_CALLS_TABLE_ID=tblAJThmoqFOr9CTF

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=toshiki@accelentai.com   # [MISSING from .env] recruiter calendar
# [n8n] The OAuth credential itself lives in the n8n credential store.

# ---------------------------------------------------------------------------
# Azure OpenAI — powers the "AI Agent" classification nodes
# ---------------------------------------------------------------------------
# [n8n] Stored as an n8n credential. Listed so the dependency is not invisible.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Timezone — single source of truth. See AUDIT #4 (four conflicting timezones).
# ---------------------------------------------------------------------------
BUSINESS_TIMEZONE=America/Vancouver
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
